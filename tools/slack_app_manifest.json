{
  "display_information": {
    "name": "NewJev",
    "description": "Computer-use agent: reads and sends Slack messages for you (every message is confirmed first).",
    "background_color": "#0d1117"
  },
  "oauth_config": {
    "redirect_urls": ["http://localhost:8766/oauth/slack/callback"],
    "scopes": {
      "user": ["chat:write", "channels:read", "groups:read", "im:read", "im:write", "mpim:read",
               "channels:history", "groups:history", "im:history", "mpim:history", "users:read", "users:read.email"]
    },
    "pkce_enabled": true,
    "token_rotation_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
