# =============================================================================
# NewJev — Computer Use Agent Configuration
# Copy this to .env and fill in your API keys.
# =============================================================================

# =============================================================================
# JEV (TypeSafe Decision Engine) — The core decision model
# =============================================================================
# Direct TypeSafe credentials (or use OpenRouter API key)
TYPESAFE_API_KEY=apikey_...
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_URL=https://api.typesafe.ai/v1

# Alternatively via OpenRouter:
OPENROUTER_API_KEY=sk-or-v1-...

# Max seconds to wait for a Jev decision response
JEV_TIMEOUT=25

# Number of automatic retries on transient errors (429, 503, 529)
JEV_MAX_RETRIES=3

# Minimum confidence threshold (0.0-1.0). Steps below this are retried, then confirmed with you.
JEV_CONFIDENCE_THRESHOLD=0.6

# =============================================================================
# TEXT LLM — Used ONLY for TYPE_TEXT (generating what to type into fields)
# and for natural-language goal understanding / planning.
# Choose one provider below and fill in the corresponding section.
# =============================================================================
# Options: openrouter | openai | anthropic | groq | huggingface | llama | moonshot
TEXT_LLM_PROVIDER=openrouter

# Model for typing text into fields (should be fast and cheap)
TEXT_LLM_MODEL=qwen/qwen3.8-27b:free

# Temperature for text generation (0.0 = deterministic, 1.0 = creative)
TEXT_LLM_TEMPERATURE=0.2

# Max tokens for text generation responses
TEXT_LLM_MAX_TOKENS=512

# Top-p sampling
TEXT_LLM_TOP_P=0.95

# Frequency penalty
TEXT_LLM_FREQUENCY_PENALTY=0.0

# Presence penalty
TEXT_LLM_PRESENCE_PENALTY=0.0

# Request timeout in seconds
TEXT_LLM_TIMEOUT=30

# Disable chain-of-thought / reasoning tokens to save costs (none | low | high)
TEXT_LLM_REASONING=none

# =============================================================================
# PLANNER LLM — Understands the user's natural language goal and creates a plan.
# Can be a different provider/model than the Text LLM.
# =============================================================================
PLANNER_LLM_PROVIDER=openrouter
PLANNER_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
PLANNER_LLM_TEMPERATURE=0.3
PLANNER_LLM_MAX_TOKENS=2048
PLANNER_LLM_TOP_P=0.95
PLANNER_LLM_TIMEOUT=30

# =============================================================================
# PROVIDER CREDENTIALS
# Fill in only the provider(s) you are using.
# =============================================================================

# --- 1. OpenRouter (recommended — access to 300+ models) ---
# OPENROUTER_API_KEY already set above (shared with Jev)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- 2. OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 3. Anthropic ---
ANTHROPIC_API_KEY=

# --- 4. Groq (very fast, free tier available) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- 5. HuggingFace Inference API ---
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/v1

# --- 6. LLaMA / Ollama / Local vLLM (OpenAI-compatible) ---
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_API_KEY=ollama
LLAMA_MODEL=llama3.1:8b

# --- 7. Moonshot / Kimi ---
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# =============================================================================
# BROWSER SETTINGS
# =============================================================================
# Show the browser window (false = headless, true = visible)
HEADLESS=false

# Browser to use: chromium | firefox | webkit
BROWSER_TYPE=chromium

# Browser channel: 'chrome' to launch your real Google Chrome installation, or 'msedge', or empty for bundled chromium
BROWSER_CHANNEL=chrome

# Directory where cookies, logins, Gmail session, and Google accounts are permanently saved
BROWSER_USER_DATA_DIR=data/chrome_profile

# Optional: Connect to an already running Chrome with remote debugging (e.g. chrome.exe --remote-debugging-port=9222)
BROWSER_CDP_URL=

# Viewport dimensions
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800

# Slow-motion delay between browser actions in ms (0 = full speed, 100+ = debug)
BROWSER_SLOW_MO=0

# Wait for DOM to settle after each action (ms)
DOM_SETTLE_MS=200

# Wait for combobox suggestions to appear (ms)
COMBOBOX_WAIT_MS=200

# =============================================================================
# AGENT SETTINGS
# =============================================================================
# Capture mode: browser | desktop | auto
CAPTURE_MODE=browser

# Maximum steps before the agent stops
MAX_STEPS=150

# Delay between steps in ms (0 = full speed)
STEP_DELAY_MS=0

# Take a screenshot on error (saved to logs/)
SCREENSHOT_ON_ERROR=true

# Take screenshot every N steps (0 = disabled)
SCREENSHOT_INTERVAL=0

# Number of recent history steps to include in Jev context
HISTORY_WINDOW=8

# Max Jev steps per phase of a multi-app plan
PHASE_MAX_STEPS=80

# =============================================================================
# RELIABILITY & SAFETY
# =============================================================================
# Below JEV_CONFIDENCE_THRESHOLD the agent re-observes and asks Jev again this many times
LOW_CONFIDENCE_RETRIES=1
# ...and if still unsure, asks you before acting (web UI / terminal). false = proceed and flag the step
CONFIRM_LOW_CONFIDENCE=true
# Only steps below this confidence are confirmed with you (others run and are flagged in the inspector).
# Switching windows/tabs, scrolling and waiting never ask.
LOW_CONFIDENCE_ASK_THRESHOLD=0.35

# Verify every DONE with an independent Jev Noul check before accepting it
VERIFY_DONE=true
DONE_VERIFY_THRESHOLD=0.7
# After this many rejected DONEs the run ends as 'unverified'
MAX_DONE_REJECTIONS=2
# Extra informational check after every step (slower; not used for decisions)
VERIFY_EACH_STEP=false

# Same action this many times in a row = loop (first time: warn Jev, second time: stop)
STUCK_REPEAT_LIMIT=3

# Ask before clicking buttons whose label matches these words
CONFIRM_RISKY_ACTIONS=true
RISKY_KEYWORDS=send,delete,remove,pay,purchase,buy now,place order,checkout,transfer,confirm payment,unsubscribe,empty trash,empty recycle bin,permanently,format,uninstall,submit order,book now

# How long to wait for you to finish a login / 2FA / CAPTCHA hand-off (seconds)
HANDOFF_TIMEOUT_S=600

# =============================================================================
# FINISHING TOUCHES (the "unsaid" steps)
# =============================================================================
# Before DONE: unsaved changes, an open rename box or an open menu must be dealt with first.
# After the task: save and close the windows the agent opened (not windows you already had open).
WRAP_UP=true
# Keep windows open when the goal is to open/show something; set false to never close windows
CLOSE_OPENED_WINDOWS=true
WRAP_UP_MAX_STEPS=10

# =============================================================================
# HOW-TO PROCEDURES & OFFICE AUTOMATION
# =============================================================================
# Before acting, write a step-by-step UI procedure (checklist) for the task: auto | always | off
# auto = desktop apps and longer web tasks. Re-planned automatically when the agent gets stuck.
PROCEDURE_MODE=auto

# How text is entered on the desktop:
#   type  = typed visibly key by key like a person, checked as it goes (garbled words are erased and retyped)
#   paste = pasted through the clipboard (fastest)       auto = type short text, paste long text
TYPING_MODE=type
# Pause between typed characters (ms). Raise it (e.g. 30) if an app still drops letters.
TYPING_DELAY_MS=15

# OFFICE_ACTION shortcut: do sort / filter / pivot / formulas / styles directly through Excel/Word automation.
# Allow-listed code only (no files, saving, macros, other documents); deleting/clearing content asks you first.
OFFICE_AUTOMATION=false

# =============================================================================
# MODEL FALLBACK, RATE LIMITS, COST
# =============================================================================
# Tried in order when the main model fails (429 rate limit, timeout, 5xx, bad key / unknown model).
# Format: provider:model, comma separated. Leave empty for no fallback.
TEXT_LLM_FALLBACKS=openrouter:qwen/qwen3.8-27b:free
PLANNER_LLM_FALLBACKS=openrouter:openai/gpt-4o-mini
# Wait for a Retry-After header up to this many seconds; longer waits switch to the next model
LLM_RETRY_AFTER_MAX_S=8
# Skip a rate-limited / failing model for this long (seconds)
LLM_COOLDOWN_S=60
# Cost estimates when the provider doesn't report cost (OpenRouter does): model=input:output USD per 1M tokens,
# e.g. LLM_PRICES=kimi-k3=0.60:2.50  (take the numbers from your provider's price page)
LLM_PRICES=

# =============================================================================
# RESCUE WHEN STUCK  (Jev retries -> rescue LLM -> your hint -> blocked)
# =============================================================================
RESCUE_ENABLED=true
# provider:model for rescues; empty = the planner LLM (and its fallbacks)
RESCUE_LLM=
MAX_RESCUES=3
# After the rescue model can't help, ask you for a hint in the chat (unattended runs never wait)
RESCUE_ASK_USER=true

# =============================================================================
# YOU TAKE OVER: pause when you use the mouse / keyboard during a run
# =============================================================================
# Real clicks / key presses (not the agent's own) pause the run: "Paused — you took over", then Resume.
# Input inside the NewJev window itself (steering, Stop, cards) never pauses it.
TAKEOVER_PAUSE=true
# Also pause on big mouse movements (default: only clicks, wheel and keys)
TAKEOVER_INCLUDE_MOVES=false
# Unattended (scheduled) runs simply wait until you've left the PC alone this many seconds
TAKEOVER_IDLE_RESUME_S=30

# =============================================================================
# LEARNED RECIPES (memory of verified runs and failures, per app / site)
# =============================================================================
RECIPES_ENABLED=true
RECIPES_PATH=data/recipes.json
# 0-1: how similar a new task must be to reuse a recipe (values like names / numbers are ignored)
RECIPE_MATCH_THRESHOLD=0.55
# Reuse the whole plan of a verified run for the same kind of request (new values swapped in): no planner call
PLAN_RECIPES=true

# =============================================================================
# VISION FALLBACK (screenshot + image model, only for apps with poor accessibility info)
# =============================================================================
VISION_FALLBACK=true
# Image-capable, OpenAI-compatible model as provider:model
VISION_LLM=openrouter:openai/gpt-4o-mini
# Offer VISUAL_CLICK when a window exposes fewer controls than this (also offered when the agent is stuck)
VISION_MIN_ELEMENTS=6

# =============================================================================
# SHORTCUTS BEYOND THE UI (mail, files) - the normal UI stays the fallback
# =============================================================================
# SEND_EMAIL / READ_EMAIL via Outlook desktop (automatic if installed) or the Gmail API (below);
# FILE_OP for copy / move / rename / new folder / text files. Sending mail always asks you first;
# FILE_OP never deletes or overwrites.
SHORTCUTS_ENABLED=true
# Gmail API: path to a Google OAuth "Desktop app" client JSON. Empty = Gmail shortcut off.
# Needs: pip install google-api-python-client google-auth-oauthlib  (first use opens a Google sign-in)
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=data/gmail_token.json
# Accounts are normally connected in the UI: Connections -> Connect (sign in, pick the workspace, done).
# Publisher client ids live in app/config/connectors.json; these override them:
SLACK_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONNECTIONS_PATH=data/connections
# Optional manual Slack token instead of Connect (xoxp-… user token or xoxb-… bot token)
SLACK_TOKEN=
# Microsoft 365 (Teams messages, calendar, OneDrive / SharePoint): an Entra ID app with public client flows on.
# Then run:  .venv\Scripts\python tools\connect_microsoft.py   (Outlook calendar works without this)
GRAPH_CLIENT_ID=
GRAPH_TENANT=organizations
GRAPH_TOKEN_PATH=data/graph_token.json

# =============================================================================
# SAVED TASKS, SCHEDULES, FOLDER TRIGGERS (run by the web UI server)
# =============================================================================
TASKS_PATH=data/tasks.json
# Long jobs ("for every file in …", "for each row in …"): progress is saved here and can be resumed
JOBS_PATH=data/jobs
SCHEDULER_ENABLED=true
SCHEDULER_POLL_S=20

# =============================================================================
# WEB UI SERVER
# =============================================================================
HOST=127.0.0.1
PORT=8766

# When the agent needs you (confirm, your turn, paused, stuck) a pop-up slides up above the taskbar (bottom-right),
# so you can answer without switching to the NewJev tab. Not shown while the NewJev window is in front.
DESKTOP_POPUPS=true

# Global hotkey that opens a small command box (type or speak a goal) from anywhere in Windows
HOTKEY_ENABLED=true
HOTKEY=ctrl+alt+j

# Automatically open browser when server starts
AUTO_OPEN_BROWSER=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# Save full execution trace as JSON (run history in the UI: History button)
SAVE_TRACES=true
# Screenshots at key moments (phase end, stuck) shown in run history
SAVE_SCREENSHOTS=true
