{
  "_doc": "Benchmark tasks. mode: browser|desktop. checks are evaluated after the run; all must pass. Placeholders: {fixtures} = local fixture server URL, {date_plus_30} = a date 30 days ahead, {email} = NEWJEV_BENCH_EMAIL, {stamp} = run timestamp. Paths starting with ~ are in the user's home folder. Only files/folders named NewJev_Bench_* are ever created or removed.",
  "tasks": [
    {
      "id": "fixture_shop",
      "tags": [
        "web",
        "offline"
      ],
      "mode": "browser",
      "url": "{fixtures}/shop.html",
      "goal": "Choose size Large, set quantity to 2, write the gift message 'Happy birthday' and add the item to the cart.",
      "checks": [
        {
          "type": "text_contains",
          "mode": "browser",
          "text": "Cart: 2 × Large — gift message: Happy birthday"
        }
      ]
    },
    {
      "id": "httpbin_form",
      "tags": [
        "web"
      ],
      "mode": "browser",
      "url": "https://httpbin.org/forms/post",
      "goal": "Fill the pizza order form: customer name 'Test User', telephone '5551234', email 'test@example.com', size Large, topping Bacon, then submit the order.",
      "checks": [
        {
          "type": "text_contains",
          "mode": "browser",
          "text": "Test User"
        },
        {
          "type": "text_contains",
          "mode": "browser",
          "text": "large"
        }
      ]
    },
    {
      "id": "wikipedia_search",
      "tags": [
        "web"
      ],
      "mode": "browser",
      "url": "https://en.wikipedia.org",
      "goal": "Search Wikipedia for Alan Turing and open his article.",
      "checks": [
        {
          "type": "url_contains",
          "mode": "browser",
          "text": "Alan_Turing"
        }
      ]
    },
    {
      "id": "youtube_first_video",
